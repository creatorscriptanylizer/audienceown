NEXT_PUBLIC_APP_URL=https://audienceown.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@audienceown.com
NEXT_PUBLIC_PRIVACY_EMAIL=contact@audienceown.com
NEXT_PUBLIC_LEGAL_ENTITY_NAME=AudienceOwn
# Optional public business address. Leave blank until an intentionally public address is approved.
NEXT_PUBLIC_COMPANY_ADDRESS=
# Server-only canonical application origin. In HTTPS-tunnel development, set this
# to the tunnel origin so OAuth state and auth cookies are created there. Also used
# by Supabase Edge Function CORS when configured as an Edge secret.
APP_URL=https://audienceown.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. SUPABASE_SERVICE_ROLE_KEY remains a supported legacy alias.
SUPABASE_ADMIN_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
CONTACT_ENCRYPTION_KEY=
RENDER_MULTIPART_PROOF_ENABLED=false
RENDER_MULTIPART_PROOF_SECRET=
RESEND_API_KEY=
# Server-only canonical sender. RESEND_FROM_EMAIL is accepted only as a legacy fallback.
DELIVERY_EMAIL_FROM=AudienceOwn <contact@mail.audienceown.com>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TOKEN_HASH_SECRET=
IP_HASH_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
# Twilio SMS Recovery Pass delivery and one-time phone verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_SENDER=
TWILIO_WHATSAPP_RECOVERY_CONTENT_SID=
DELIVERY_OPERATOR_USER_IDS=
DELIVERY_ADMIN_USER_IDS=
DELIVERY_ALERT_QUEUE_DEPTH=100
DELIVERY_ALERT_STUCK_COUNT=1
DELIVERY_ALERT_PENDING_CALLBACK_COUNT=10
DELIVERY_ALERT_FAILURE_RATE_PERCENT=20
DELIVERY_ALERT_OLDEST_QUEUE_SECONDS=900
# YouTube OAuth and social watcher (all values below are server-only).
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=https://audienceown.com/api/integrations/youtube/callback
YOUTUBE_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_WORKER_SECRET=
# Recommended scheduler cadence: 5–10 minutes.
SOCIAL_POLL_INTERVAL_MINUTES=5
SOCIAL_OAUTH_STATE_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Must exactly match the Meta console callback. Use an HTTPS tunnel origin for live development OAuth when localhost is rejected.
INSTAGRAM_REDIRECT_URI=https://audienceown.com/api/integrations/instagram/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Web Login Kit requires an exact, static HTTPS redirect URI, including for local development.
TIKTOK_REDIRECT_URI=https://audienceown.com/api/integrations/tiktok/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://audienceown.com/api/integrations/x/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify rejects localhost; use an explicit loopback IP for HTTP development.
SPOTIFY_REDIRECT_URI=https://audienceown.com/api/integrations/spotify/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://audienceown.com/api/integrations/twitch/callback
TWITCH_EVENTSUB_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn requires an absolute HTTPS redirect URI registered in the developer portal.
LINKEDIN_REDIRECT_URI=https://audienceown.com/api/integrations/linkedin/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://audienceown.com/api/integrations/facebook/callback
# Shared Facebook Login callback used for Facebook Pages and linked Instagram assets.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
SNAPCHAT_CLIENT_ID=
